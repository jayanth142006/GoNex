# ---------------------------------------------------------------------------
# GoNex backend configuration. Copy to `.env` for local development.
# Never commit real secrets. In production, set these in the Render dashboard.
# ---------------------------------------------------------------------------

# Required. Groq API key (https://console.groq.com/keys). Server-side only.
LLM_API_KEY=

# Required in production. Comma-separated list of frontend origins allowed by CORS
# (scheme + host + optional port, no path). Add dev origins only where needed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional (defaults shown) ---------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Set to "true" behind Render's proxy so rate limiting uses the real client IP.
# Accepts true | false | number of trusted hops | comma-separated proxy IPs/CIDRs.
TRUST_PROXY=false

# Groq model and generation limits
LLM_MODEL=openai/gpt-oss-120b
# Reasoning effort for reasoning models (gpt-oss / qwen3): none|default|low|medium|high, or empty to omit.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000

# Knowledge: "retrieval" sends only the most relevant sections of knowledge/cryptonet.md
# (~2k prompt tokens/request, needed on Groq's free tier); "full" sends the whole file (~6k).
KNOWLEDGE_MODE=retrieval
KNOWLEDGE_TOKEN_BUDGET=1600

# Serve the built-in chat UI at "/" (set to false for API-only deployments).
SERVE_WEB_UI=true

# Conversation memory. Leave REDIS_URL empty to use in-process memory.
REDIS_URL=
CONVERSATION_TTL_SECONDS=3600
MAX_HISTORY_MESSAGES=8

# Abuse protection
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
